            "items": [{"client_item_key": "item1", "food": {"kind": "unknown", "name": "fixture food"}, "quantity": {"kind": "unknown", "description": "unknown amount"}}]
          },
          "evidence": [{"field": "food", "item_key": "item1", "source_kind": "user_message", "source_ref": "fixture-message", "original_text": "fixture food", "operation": "set", "status": "explicit"}]
        }
      }
    },
    {
      "id": "intake-revise", "schema_valid": true,
      "input": {
        "tool": "prepare_intake_draft",
        "arguments": {
          "action": "revise", "draft_id": "11111111-1111-4111-8111-111111111111", "base_version": 1,
          "patch": {"temporal": {"note": null}},
          "evidence": [{"field": "note", "source_kind": "user_form", "source_ref": "fixture-form", "original_text": "", "operation": "clear", "status": "explicit"}]
        }
      }
    },
    {
      "id": "intake-discard", "schema_valid": true,
      "input": {
        "tool": "prepare_intake_draft",
        "arguments": {
          "action": "discard", "draft_id": "11111111-1111-4111-8111-111111111111", "base_version": 1,
