      "id": "read-search", "schema_valid": true,
      "input": {"tool": "search_foods", "arguments": {"query": "contract fixture", "limit": 10}}
    },
    {
      "id": "read-plans", "schema_valid": true,
      "input": {"tool": "get_meal_plans", "arguments": {"scope": {"kind": "range", "start_date": "2026-11-09", "end_date": "2026-11-15"}}}
    },
    {
      "id": "read-logs", "schema_valid": true,
      "input": {"tool": "get_diet_logs", "arguments": {"scope": {"kind": "id", "id": "11111111-1111-4111-8111-111111111111"}, "include_deleted": true}}
