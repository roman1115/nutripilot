      "input": {
        "tool": "prepare_diet_log_change",
        "arguments": {
          "action": "correct", "record_id": "11111111-1111-4111-8111-111111111111", "base_version": 1,
          "patch": {"item_edits": [{"action": "remove", "item_id": "22222222-2222-4222-8222-222222222222"}]},
          "evidence": [{"field": "operation", "source_kind": "user_message", "source_ref": "fixture-message", "original_text": "remove one item", "operation": "set", "status": "explicit"}]
        }
      }
    },
    {
      "id": "log-delete", "schema_valid": true, "base": "log-correct",
      "changes": [
        {"path": ["arguments", "action"], "value": "delete"},
        {"path": ["arguments", "patch"], "remove": true}
      ]
