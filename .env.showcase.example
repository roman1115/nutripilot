# Copy this file to .env for the real job-interview showcase stack.
APP_ENV=showcase
APP_MODE=docker
USER_TIMEZONE=America/Los_Angeles

MODEL_PROVIDER=openai
MODEL_NAME=qwen-plus
MODEL_FALLBACK_NAME=qwen-turbo
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=replace-with-your-dashscope-key
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANK_PROVIDER=bge
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
# Optional: mount pre-downloaded models and use /models/... paths above.
BGE_MODEL_ROOT=./.models

DATABASE_URL=postgresql+asyncpg://nutripilot:nutripilot@postgres:5432/nutripilot
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=meal_search_bge_m3

MCP_ENABLED=true
MCP_SERVER_URL=http://nutrition-mcp:8010/mcp
MCP_INTERNAL_TOKEN=replace-with-a-random-internal-token
MCP_TIMEOUT_SECONDS=120
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,nutrition-mcp:*

WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
