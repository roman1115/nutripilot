APP_ENV=development
APP_MODE=demo
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# demo uses deterministic local adapters and requires no external credentials.
MODEL_PROVIDER=fake
MODEL_NAME=qwen-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_FALLBACK_NAME=
MODEL_TIMEOUT_SECONDS=25
MODEL_MAX_RETRIES=2
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=
RERANK_PROVIDER=lexical
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=
AGENT_MAX_STEPS=8
AGENT_DEADLINE_SECONDS=90
AGENT_TOKEN_BUDGET=24000
# Optional durable traces/reports. External mode defaults to .runtime/observability.sqlite3.
RUN_STORE_PATH=
# JSON object mapping 32+ character random access tokens to user IDs.
# Required in production. Enter an access token in the browser; never embed it in VITE_*.
API_ACCESS_TOKENS={}
API_RATE_LIMIT_PER_MINUTE=60

DATABASE_URL=postgresql+asyncpg://nutripilot:nutripilot@postgres:5432/nutripilot
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=meal_search

MCP_ENABLED=true
MCP_SERVER_URL=http://nutrition-mcp:8010/mcp
MCP_INTERNAL_TOKEN=change-me
MCP_TIMEOUT_SECONDS=8

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

WEATHER_PROVIDER=fake
WEATHER_API_KEY=
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
